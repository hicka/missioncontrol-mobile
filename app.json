{
  "expo": {
    "name": "Mission Control",
    "slug": "missioncontrol-mobile",
    "version": "4.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0a0b0d",
    "ios": {
      "bundleIdentifier": "com.hicka.missioncontrol",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Mission Control connects to the Mission Control running on your Mac over your local network."
      }
    },
    "android": {
      "package": "com.hicka.missioncontrol",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0a0b0d"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Mission Control attaches photos you pick to chat messages."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Mission Control listens so you can talk to your agent.",
          "speechRecognitionPermission": "Mission Control turns what you say into messages, on this device."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {}
      ],
      "expo-font",
      "./plugins/withGradleMemory"
    ],
    "extra": {
      "eas": {
        "projectId": "dc1999a8-df78-4a8d-bb0c-8ead2fb883c0"
      }
    },
    "owner": "hicker",
    "scheme": "missioncontrol"
  }
}
